{
    "name": "steno",
    "productName": "Sténo",
    "version": "1.0.0",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev --watch",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
        "build": "pnpm run typecheck && electron-vite build",
        "build:native": "sh scripts/build-native.sh",
        "build:brand": "electron scripts/build-brand.js",
        "package": "sh scripts/package.sh",
        "release": "sh scripts/release.sh"
    },
    "dependencies": {
        "@ai-sdk/gateway": "^4.0.106",
        "ai": "^7.0.130",
        "dotenv": "^16.4.7",
        "openai": "^4.77.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^44.6.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^7.3.6"
    },
    "build": {
        "appId": "com.devify.steno",
        "electronDist": "node_modules/electron/dist",
        "npmRebuild": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*"
        ],
        "extraResources": [
            {
                "from": "bin/steno-recorder",
                "to": "bin/steno-recorder"
            }
        ],
        "mac": {
            "target": "dir",
            "icon": "brand/icon/steno-icon.icns",
            "hardenedRuntime": false,
            "notarize": false,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Sténo enregistre ton micro pour la dictée et pendant les appels, pour les transcrire.",
                "NSAudioCaptureUsageDescription": "Sténo enregistre le son des autres participants pendant les appels pour les transcrire.",
                "NSAppleEventsUsageDescription": "Sténo passe par System Events pour coller le texte, et lit l'adresse des onglets de ton navigateur pour repérer un appel Google Meet, Teams ou Slack."
            }
        }
    }
}
